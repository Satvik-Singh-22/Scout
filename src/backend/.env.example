# ============================================================
# Scout — Environment Variables Template
#
# DO NOT ADD REAL SECRETS TO THIS FILE!
# This serves as documentation for what environment variables are required.
# NEVER commit .env — only .env.example belongs in the repo.
# ============================================================

# ---------------------------------------------------------------------------
# PostgreSQL on Neon.tech (use the asyncpg connection string)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:password@host.neon.tech/neondb

# ---------------------------------------------------------------------------
# Groq LLM — free tier at https://console.groq.com
# ---------------------------------------------------------------------------
# Single key (backward compatible):
GROQ_API_KEY=gsk_your_key_here
# Multiple keys for rotation (comma-separated, recommended for demos):
# Each free Groq account has independent rate limits (30 RPM).
# With 3 keys you get ~90 RPM effective throughput.
# GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3

# ---------------------------------------------------------------------------
# SMTP Email (Gmail) — uses App Password, not your regular password
# Generate at: https://myaccount.google.com/apppasswords
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_NAME=Scout

# ---------------------------------------------------------------------------
# JWT Authentication
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
JWT_SECRET=your_32_character_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------------
# ChromaDB — local persistence path for vector store
# ---------------------------------------------------------------------------
CHROMA_PERSIST_PATH=./chroma_data

# ---------------------------------------------------------------------------
# Slack Integration (User OAuth token — starts with xoxp-)
# Generate at: https://api.slack.com/apps → OAuth & Permissions
# Required scopes: search:read
# ---------------------------------------------------------------------------
# SLACK_USER_TOKEN=xoxp-your-slack-user-token

# ---------------------------------------------------------------------------
# Jira Integration (Basic Auth with API token)
# Generate API token at: https://id.atlassian.com/manage-profile/security/api-tokens
# ---------------------------------------------------------------------------
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_EMAIL=your-jira-email@example.com
# JIRA_API_TOKEN=your-jira-api-token
